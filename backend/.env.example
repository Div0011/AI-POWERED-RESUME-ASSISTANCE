# AI-POWERED RESUME ASSISTANCE - Environment Configuration
# Duplicate this file to .env and fill in your values.

# --- Core API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database ---
DATABASE_URL=sqlite:///./resume.db

# --- Gmail Automation (OAuth2) ---
# Your Gmail address used for polling and automation
GMAIL_USER_EMAIL=your_email@gmail.com

# --- Security ---
SECRET_KEY=your_random_secret_string_here

# --- Monitoring (Optional) ---
SENTRY_DSN=your_sentry_dsn_here
